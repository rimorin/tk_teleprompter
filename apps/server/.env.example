# ---- Required for live voice tracking --------------------------------------------------------
# Deepgram API key (server-side only; never exposed to the browser).
DEEPGRAM_API_KEY=

# ---- Access protection (strongly recommended on any public deployment) ---------------------
# Shared passcode users must enter before voice tracking starts. Unset = no passcode.
APP_ACCESS_CODE=
# MAX_CONCURRENT_SESSIONS=10
# MAX_SESSIONS_PER_IP=10   # speakers sharing one network (venue/office Wi-Fi) share an IP
# MAX_SESSION_MINUTES=90
# MAX_ACCESS_FAILURES=10
# ACCESS_FAILURE_WINDOW_MINUTES=15

# ---- Networking ------------------------------------------------------------------------------
PORT=8787
# 127.0.0.1 locally; the Docker image uses :: (all interfaces, IPv4 and IPv6).
HOST=127.0.0.1
# Browser origins allowed to open the audio WebSocket (comma-separated).
# ALLOWED_ORIGINS=https://prompter.example.com
# Set true when running behind a reverse proxy that sets X-Forwarded-For (e.g. the web image).
# TRUST_PROXY=false
# Seconds to finalize open sessions on SIGTERM (keep below the platform's stop timeout).
# SHUTDOWN_GRACE_SECONDS=8

# ---- Provider overrides ----------------------------------------------------------------------
# DEEPGRAM_URL=wss://api.deepgram.com/v1/listen
# DEEPGRAM_MODEL=nova-3
# LOG_LEVEL=info
